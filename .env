
---

## 🔐 2. .env

```env
# ============================================
# VARIABLES DE ENTORNO - IGLESIA VIDA NUEVA
# ============================================

# Información de la Iglesia
VITE_CHURCH_NAME=Iglesia Vida Nueva
VITE_CHURCH_SLOGAN=Un lugar para crecer en fe
VITE_CHURCH_ADDRESS=Av. Principal #123, Col. Centro, Ciudad
VITE_CHURCH_CITY=Ciudad de México
VITE_CHURCH_COUNTRY=México

# Contacto
VITE_CONTACT_EMAIL=info@vidanueva.org
VITE_CONTACT_PHONE=+1234567890
VITE_CONTACT_WHATSAPP=1234567890
VITE_PASTOR_EMAIL=pastores@vidanueva.org

# Redes Sociales
VITE_FACEBOOK_URL=https://facebook.com/vidanueva
VITE_INSTAGRAM_URL=https://instagram.com/vidanueva
VITE_YOUTUBE_URL=https://youtube.com/@vidanueva
VITE_SPOTIFY_URL=https://open.spotify.com/show/vidanueva

# Google Maps
VITE_GOOGLE_MAPS_API_KEY=tu_api_key_aqui
VITE_MAP_LATITUDE=19.4326
VITE_MAP_LONGITUDE=-99.1332
VITE_MAP_ZOOM=15

# Servicios y Horarios
VITE_SERVICE_SUNDAY_1=09:00
VITE_SERVICE_SUNDAY_2=11:30
VITE_SERVICE_SUNDAY_3=18:00
VITE_SERVICE_WEDNESDAY=19:00
VITE_SERVICE_FRIDAY=19:30

# Donaciones
VITE_DONATION_ENABLED=true
VITE_PAYPAL_CLIENT_ID=tu_paypal_client_id
VITE_STRIPE_PUBLIC_KEY=tu_stripe_public_key
VITE_BANK_ACCOUNT=1234567890
VITE_BANK_NAME=Banco Nacional
VITE_MINIMUM_DONATION=10
VITE_CURRENCY=USD

# Newsletter
VITE_MAILCHIMP_API_KEY=tu_mailchimp_api_key
VITE_MAILCHIMP_LIST_ID=tu_list_id

# Analytics
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
VITE_FACEBOOK_PIXEL_ID=tu_pixel_id

# Sermones
VITE_SERMON_AUDIO_URL=https://audio.vidanueva.org/sermons
VITE_PODCAST_FEED_URL=https://podcast.vidanueva.org/feed

# API Endpoints
VITE_API_BASE_URL=https://api.vidanueva.org
VITE_API_EVENTS_ENDPOINT=/events
VITE_API_SERMONS_ENDPOINT=/sermons
VITE_API_BLOG_ENDPOINT=/blog

# Configuración del Sitio
VITE_SITE_URL=https://vidanueva.org
VITE_SITE_TITLE=Iglesia Vida Nueva
VITE_SITE_DESCRIPTION=Una comunidad de fe donde puedes crecer espiritualmente
VITE_SITE_KEYWORDS=iglesia,cristiana,fe,Dios,Jesús,oración,biblia
VITE_SITE_LANGUAGE=es
VITE_SITE_TIMEZONE=America/Mexico_City

# Configuración de Eventos
VITE_MAX_EVENT_ATTENDEES=500
VITE_EVENT_REGISTRATION_ENABLED=true
VITE_EVENT_REMINDER_DAYS=3

# Configuración de Galería
VITE_GALLERY_IMAGES_PER_PAGE=12
VITE_GALLERY_ENABLED=true

# Configuración de Blog
VITE_POSTS_PER_PAGE=6
VITE_BLOG_ENABLED=true

# Modo de Desarrollo
VITE_APP_ENV=development
VITE_DEBUG_MODE=true
VITE_SHOW_CONSOLE_LOGS=true

# Seguridad
VITE_RECAPTCHA_SITE_KEY=tu_recaptcha_site_key
VITE_CSRF_TOKEN=tu_csrf_token

# Cache
VITE_CACHE_DURATION=3600
VITE_ENABLE_SERVICE_WORKER=false

# Features Flags
VITE_ENABLE_LIVESTREAM=true
VITE_ENABLE_PRAYER_REQUEST=true
VITE_ENABLE_BIBLE_VERSE_OF_DAY=true
VITE_ENABLE_ONLINE_GIVING=true
VITE_ENABLE_EVENT_CALENDAR=true

# ============================================
# NOTAS IMPORTANTES:
# ============================================
# 1. NO commitear este archivo con datos sensibles
# 2. Crear un .env.example sin valores reales
# 3. Usar variables diferentes para producción
# 4. Rotar API keys periódicamente
# 5. Mantener backups seguros de las credenciales